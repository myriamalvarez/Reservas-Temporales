@model Propietario
@{
    ViewData["Title"] = "Detalle del propietario";
}

<h1>@Model.Nombre @Model.Apellido</h1>

<ul class="list-group mb-4">
    <li class="list-group-item"><strong>DNI:</strong> @Model.Dni</li>
    <li class="list-group-item"><strong>Email:</strong> @Model.Email</li>
    <li class="list-group-item"><strong>Teléfono:</strong> @Model.Telefono</li>
</ul>

<div class="d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Editar</a>
    <a asp-controller="Inmueble" asp-action="Index" asp-route-idPropietario="@Model.Id" class="btn btn-outline-primary">
        Ver sus inmuebles
    </a>
    <form asp-action="Eliminar" method="post" onsubmit="return confirm('¿Eliminar este propietario?');">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-outline-danger">Eliminar</button>
    </form>
</div>

