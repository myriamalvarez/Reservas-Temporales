@model Inmueble
@{
    ViewData["Title"] = "Nuevo inmueble";
}

<h1>Nuevo inmueble</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Propietario</label>
        <select asp-for="IdPropietario" class="form-select" asp-items="ViewBag.Propietarios"></select>
    </div>
    <div class="mb-3">
        <label class="form-label">Tipo</label>
        <select asp-for="IdTipo" class="form-select" asp-items="ViewBag.Tipos"></select>
    </div>
    <div class="mb-3">
        <label asp-for="Direccion" class="form-label"></label>
        <input asp-for="Direccion" class="form-control" />
        <span asp-validation-for="Direccion" class="text-danger"></span>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Cupo" class="form-label"></label>
            <input asp-for="Cupo" class="form-control" />
            <span asp-validation-for="Cupo" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="PrecioDia" class="form-label">Precio por día</label>
            <input asp-for="PrecioDia" class="form-control" />
            <span asp-validation-for="PrecioDia" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="PorcentajeSena" class="form-label">Porcentaje de seña (%)</label>
            <input asp-for="PorcentajeSena" class="form-control" />
            <span asp-validation-for="PorcentajeSena" class="text-danger"></span>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Coord" class="form-label">Coordenadas</label>
        <input asp-for="Coord" class="form-control" placeholder="lat, long" />
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>
