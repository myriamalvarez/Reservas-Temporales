@{
    ViewData["Title"] = "Inmuebles";
    var propietarios = ViewBag.Propietarios as List<Propietario> ?? new List<Propietario>();
}

<h1>Inmuebles</h1>

<div id="app">
    <div class="row g-2 mb-3">
        <div class="col-auto">
            <select class="form-select" v-model="filtroEstado" @@change="irAPagina(1)">
                <option value="">-- Todos los estados --</option>
                <option value="Disponible">Disponible</option>
                <option value="Suspendido">Suspendido</option>
            </select>
        </div>
        <div class="col-auto">
            <select class="form-select" v-model="filtroPropietario" @@change="irAPagina(1)">
                <option value="">-- Todos los propietarios --</option>
                @foreach (var propietario in propietarios)
                {
                    <option value="@propietario.Id">@propietario.Nombre @propietario.Apellido</option>
                }
            </select>
        </div>
        <div class="col-auto ms-auto">
            <a href="/Inmueble/Create" class="btn btn-primary">+ Nuevo inmueble</a>
        </div>
    </div>

    <div v-if="cargando" class="text-muted">Cargando...</div>
    <div v-else-if="error" class="alert alert-danger">{{ error }}</div>

    <table v-else class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Dirección</th>
                <th>Tipo</th>
                <th>Propietario</th>
                <th>Cupo</th>
                <th>Precio/día</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr v-if="inmuebles.length === 0">
                <td colspan="7" class="text-center text-muted">No hay inmuebles para mostrar.</td>
            </tr>
            <tr v-for="inmueble in inmuebles" :key="inmueble.id">
                <td>{{ inmueble.direccion }}</td>
                <td>{{ inmueble.tipo }}</td>
                <td>{{ inmueble.propietario }}</td>
                <td>{{ inmueble.cupo }}</td>
                <td>{{ formatearMoneda(inmueble.precioDia) }}</td>
                <td>
                    <span class="badge" :class="inmueble.estado === 'Disponible' ? 'bg-success' : 'bg-secondary'">
                        {{ inmueble.estado }}
                    </span>
                </td>
                <td><a :href="'/Inmueble/Details/' + inmueble.id">Ver</a></td>
            </tr>
        </tbody>
    </table>

    <nav v-if="!cargando && !error && totalPaginas > 1" aria-label="Paginado de inmuebles">
        <ul class="pagination">
            <li class="page-item" :class="{ disabled: pagina === 1 }">
                <button class="page-link" @@click="irAPagina(pagina - 1)">Anterior</button>
            </li>
            <li v-for="p in totalPaginas" :key="p" class="page-item" :class="{ active: p === pagina }">
                <button class="page-link" @@click="irAPagina(p)">{{ p }}</button>
            </li>
            <li class="page-item" :class="{ disabled: pagina === totalPaginas }">
                <button class="page-link" @@click="irAPagina(pagina + 1)">Siguiente</button>
            </li>
        </ul>
    </nav>
</div>

@section Scripts {
    <script>
        Vue.createApp({
            data() {
                return {
                    inmuebles: [],
                    pagina: 1,
                    tamanioPagina: 10,
                    totalPaginas: 1,
                    filtroEstado: '@ViewBag.EstadoInicial',
                    filtroPropietario: '@(ViewBag.IdPropietarioInicial?.ToString() ?? "")',
                    cargando: true,
                    error: null
                };
            },
            methods: {
                async cargar() {
                    this.cargando = true;
                    this.error = null;
                    try {
                        const parametros = new URLSearchParams({
                            pagina: this.pagina,
                            tamanioPagina: this.tamanioPagina
                        });
                        if (this.filtroEstado) parametros.append('estado', this.filtroEstado);
                        if (this.filtroPropietario) parametros.append('idPropietario', this.filtroPropietario);

                        const respuesta = await fetch('/Inmueble/ListarJson?' + parametros.toString());
                        if (!respuesta.ok) throw new Error('No se pudo cargar el listado.');

                        const datos = await respuesta.json();
                        this.inmuebles = datos.items;
                        this.totalPaginas = datos.totalPaginas;
                    } catch (e) {
                        this.error = e.message;
                    } finally {
                        this.cargando = false;
                    }
                },
                irAPagina(nuevaPagina) {
                    if (nuevaPagina < 1 || nuevaPagina > this.totalPaginas) return;
                    this.pagina = nuevaPagina;
                    this.cargar();
                },
                formatearMoneda(valor) {
                    return new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' }).format(valor);
                }
            },
            mounted() {
                this.cargar();
            }
        }).mount('#app');
    </script>
}

