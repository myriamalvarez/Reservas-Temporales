@{
    ViewData["Title"] = "Todas las reservas";
}

<h1 class="mb-3">Todas las reservas</h1>

<div id="app">
    <div class="row g-2 mb-3">
        <div class="col-auto">
            <select class="form-select" v-model="filtroEstado" @@change="irAPagina(1)">
                <option value="">-- Todos los estados --</option>
                <option value="Vigente">Vigente</option>
                <option value="Finalizada">Finalizada</option>
                <option value="FinalizadaAnticipada">Finalizada anticipadamente</option>
            </select>
        </div>
    </div>

    <div v-if="cargando" class="text-muted">Cargando...</div>
    <div v-else-if="error" class="alert alert-danger">{{ error }}</div>

    <table v-else class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Inmueble</th>
                <th>Inquilino</th>
                <th>Desde</th>
                <th>Hasta</th>
                <th>Monto/día</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr v-if="reservas.length === 0">
                <td colspan="7" class="text-center text-muted">No hay reservas para mostrar.</td>
            </tr>
            <tr v-for="reserva in reservas" :key="reserva.id">
                <td>{{ reserva.inmuebleDireccion }}</td>
                <td>{{ reserva.inquilinoNombre }}</td>
                <td>{{ reserva.fechaDesde }}</td>
                <td>{{ reserva.fechaHasta }}</td>
                <td>{{ formatearMoneda(reserva.montoDiario) }}</td>
                <td>
                    <span class="badge" :class="reserva.estado === 'Vigente' ? 'bg-success' : 'bg-secondary'">
                        {{ reserva.estado }}
                    </span>
                </td>
                <td><a :href="'/Reserva/Details/' + reserva.id">Ver</a></td>
            </tr>
        </tbody>
    </table>

    <nav v-if="!cargando && !error && totalPaginas > 1" aria-label="Paginado de reservas">
        <ul class="pagination">
            <li class="page-item" :class="{ disabled: pagina === 1 }">
                <button class="page-link" @@click="irAPagina(pagina - 1)">Anterior</button>
            </li>
            <li v-for="p in totalPaginas" :key="p" class="page-item" :class="{ active: p === pagina }">
                <button class="page-link" @@click="irAPagina(p)">{{ p }}</button>
            </li>
            <li class="page-item" :class="{ disabled: pagina === totalPaginas }">
                <button class="page-link" @@click="irAPagina(pagina + 1)">Siguiente</button>
            </li>
        </ul>
    </nav>
</div>

@section Scripts {
    <script>
        Vue.createApp({
            data() {
                return {
                    reservas: [],
                    pagina: 1,
                    tamanioPagina: 10,
                    totalPaginas: 1,
                    filtroEstado: '',
                    cargando: true,
                    error: null
                };
            },
            methods: {
                async cargar() {
                    this.cargando = true;
                    this.error = null;
                    try {
                        const parametros = new URLSearchParams({
                            pagina: this.pagina,
                            tamanioPagina: this.tamanioPagina
                        });
                        if (this.filtroEstado) parametros.append('estado', this.filtroEstado);

                        const respuesta = await fetch('/Reserva/TodasJson?' + parametros.toString());
                        if (!respuesta.ok) throw new Error('No se pudo cargar el listado.');

                        const datos = await respuesta.json();
                        this.reservas = datos.items;
                        this.totalPaginas = datos.totalPaginas;
                    } catch (e) {
                        this.error = e.message;
                    } finally {
                        this.cargando = false;
                    }
                },
                irAPagina(nuevaPagina) {
                    if (nuevaPagina < 1 || nuevaPagina > this.totalPaginas) return;
                    this.pagina = nuevaPagina;
                    this.cargar();
                },
                formatearMoneda(valor) {
                    return new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' }).format(valor);
                }
            },
            mounted() {
                this.cargar();
            }
        }).mount('#app');
    </script>
}

