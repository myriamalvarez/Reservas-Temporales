@{
    ViewData["Title"] = "Inmuebles más reservados";
}

<h1 class="mb-3">Inmuebles más reservados</h1>

<div id="app">
    <form class="row g-2 mb-3" @@submit.prevent="irAPagina(1)">
        <div class="col-auto">
            <label class="col-form-label">Período (días)</label>
        </div>
        <div class="col-auto">
            <input type="number" class="form-control" v-model.number="dias" min="1" style="width:100px" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-secondary">Aplicar</button>
        </div>
    </form>

    <div v-if="cargando" class="text-muted">Cargando...</div>
    <div v-else-if="error" class="alert alert-danger">{{ error }}</div>

    <table v-else class="table table-hover align-middle">
        <thead>
            <tr>
                <th>#</th>
                <th>Inmueble</th>
                <th>Propietario</th>
                <th>Reservas en el período</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr v-if="inmuebles.length === 0">
                <td colspan="5" class="text-center text-muted">No hay inmuebles para mostrar.</td>
            </tr>
            <tr v-for="(inmueble, index) in inmuebles" :key="inmueble.id">
                <td>{{ (pagina - 1) * tamanioPagina + index + 1 }}</td>
                <td>{{ inmueble.direccion }}</td>
                <td>{{ inmueble.propietarioNombre }}</td>
                <td>
                    <span class="badge" :class="inmueble.cantidadReservas > 0 ? 'bg-primary' : 'bg-secondary'">
                        {{ inmueble.cantidadReservas }}
                    </span>
                </td>
                <td><a :href="'/Inmueble/Details/' + inmueble.id">Ver</a></td>
            </tr>
        </tbody>
    </table>

    <nav v-if="!cargando && !error && totalPaginas > 1" aria-label="Paginado del informe">
        <ul class="pagination">
            <li class="page-item" :class="{ disabled: pagina === 1 }">
                <button class="page-link" @@click="irAPagina(pagina - 1)">Anterior</button>
            </li>
            <li v-for="p in totalPaginas" :key="p" class="page-item" :class="{ active: p === pagina }">
                <button class="page-link" @@click="irAPagina(p)">{{ p }}</button>
            </li>
            <li class="page-item" :class="{ disabled: pagina === totalPaginas }">
                <button class="page-link" @@click="irAPagina(pagina + 1)">Siguiente</button>
            </li>
        </ul>
    </nav>
</div>

@section Scripts {
    <script>
        Vue.createApp({
            data() {
                return {
                    inmuebles: [],
                    pagina: 1,
                    tamanioPagina: 10,
                    totalPaginas: 1,
                    dias: 365,
                    cargando: true,
                    error: null
                };
            },
            methods: {
                async cargar() {
                    this.cargando = true;
                    this.error = null;
                    try {
                        const parametros = new URLSearchParams({
                            pagina: this.pagina,
                            tamanioPagina: this.tamanioPagina,
                            dias: this.dias
                        });
                        const respuesta = await fetch('/Informe/MasReservadosJson?' + parametros.toString());
                        if (!respuesta.ok) throw new Error('No se pudo cargar el informe.');

                        const datos = await respuesta.json();
                        this.inmuebles = datos.items;
                        this.totalPaginas = datos.totalPaginas;
                    } catch (e) {
                        this.error = e.message;
                    } finally {
                        this.cargando = false;
                    }
                },
                irAPagina(nuevaPagina) {
                    if (nuevaPagina < 1 || (this.totalPaginas && nuevaPagina > this.totalPaginas)) return;
                    this.pagina = nuevaPagina;
                    this.cargar();
                }
            },
            mounted() {
                this.cargar();
            }
        }).mount('#app');
    </script>
}

