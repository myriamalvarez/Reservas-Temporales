@{
    ViewData["Title"] = "Pagos";
}

<h1 class="mb-3">Pagos</h1>

<div id="app">
    <div class="row g-2 mb-3">
        <div class="col-auto">
            <select class="form-select" v-model="filtroAnulado" @@change="irAPagina(1)">
                <option value="">-- Todos --</option>
                <option value="false">Solo activos</option>
                <option value="true">Solo anulados</option>
            </select>
        </div>
    </div>

    <div v-if="cargando" class="text-muted">Cargando...</div>
    <div v-else-if="error" class="alert alert-danger">{{ error }}</div>

    <table v-else class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Concepto</th>
                <th>Inmueble</th>
                <th>Inquilino</th>
                <th>Fecha</th>
                <th>Importe</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr v-if="pagos.length === 0">
                <td colspan="7" class="text-center text-muted">No hay pagos para mostrar.</td>
            </tr>
            <tr v-for="pago in pagos" :key="pago.id" :class="pago.anulado ? 'text-decoration-line-through text-muted' : ''">
                <td>{{ pago.concepto }}</td>
                <td>{{ pago.inmuebleDireccion }}</td>
                <td>{{ pago.inquilinoNombre }}</td>
                <td>{{ pago.fechaPago }}</td>
                <td>{{ formatearMoneda(pago.importe) }}</td>
                <td>
                    <span class="badge" :class="pago.anulado ? 'bg-secondary' : 'bg-success'">
                        {{ pago.anulado ? 'Anulado' : 'Activo' }}
                    </span>
                </td>
                <td><a :href="'/Reserva/Details/' + pago.idReserva">Ver reserva</a></td>
            </tr>
        </tbody>
    </table>

    <nav v-if="!cargando && !error && totalPaginas > 1" aria-label="Paginado de pagos">
        <ul class="pagination">
            <li class="page-item" :class="{ disabled: pagina === 1 }">
                <button class="page-link" @@click="irAPagina(pagina - 1)">Anterior</button>
            </li>
            <li v-for="p in totalPaginas" :key="p" class="page-item" :class="{ active: p === pagina }">
                <button class="page-link" @@click="irAPagina(p)">{{ p }}</button>
            </li>
            <li class="page-item" :class="{ disabled: pagina === totalPaginas }">
                <button class="page-link" @@click="irAPagina(pagina + 1)">Siguiente</button>
            </li>
        </ul>
    </nav>
</div>

@section Scripts {
    <script>
        Vue.createApp({
            data() {
                return {
                    pagos: [],
                    pagina: 1,
                    tamanioPagina: 10,
                    totalPaginas: 1,
                    filtroAnulado: '',
                    cargando: true,
                    error: null
                };
            },
            methods: {
                async cargar() {
                    this.cargando = true;
                    this.error = null;
                    try {
                        const parametros = new URLSearchParams({
                            pagina: this.pagina,
                            tamanioPagina: this.tamanioPagina
                        });
                        if (this.filtroAnulado !== '') parametros.append('anulado', this.filtroAnulado);

                        const respuesta = await fetch('/Pago/ListarJson?' + parametros.toString());
                        if (!respuesta.ok) throw new Error('No se pudo cargar el listado.');

                        const datos = await respuesta.json();
                        this.pagos = datos.items;
                        this.totalPaginas = datos.totalPaginas;
                    } catch (e) {
                        this.error = e.message;
                    } finally {
                        this.cargando = false;
                    }
                },
                irAPagina(nuevaPagina) {
                    if (nuevaPagina < 1 || nuevaPagina > this.totalPaginas) return;
                    this.pagina = nuevaPagina;
                    this.cargar();
                },
                formatearMoneda(valor) {
                    return new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' }).format(valor);
                }
            },
            mounted() {
                this.cargar();
            }
        }).mount('#app');
    </script>
}

